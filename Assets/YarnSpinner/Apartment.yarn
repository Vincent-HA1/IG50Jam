title: Eviction_Under_Door
---
<<declare $seen_eviction = false>>
<<if $seen_eviction == false>>
	<<start_character_conv CharacterManager "Ashe">>
	Ashe: What the...
	<<show_character_expression CharacterManager "Ashe" "sad">>
	Ashe: We're getting ... evicted?
	Ashe: ...
	<<set $seen_eviction = true>>
	<<allow_travel GameManager>>
<<else>>
	...
	No point looking at it again
<<endif>>
<<end_character_conv CharacterManager>>
